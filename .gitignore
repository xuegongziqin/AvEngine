# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.coverage

# ---- 临时/探针残留 ----
# Python 的 tempfile.mkdtemp() 在临时目录被指到仓库时会留下 tmpXXXXXXXX 目录；
# 沙箱 ACL 诊断会在仓库根留下 ._acl_probe_*.txt。
tmp*/
.tmp*/
._acl_probe_*.txt
avx_*.log

# ---- 虚拟环境 ----
venv/
.venv/
env/

# ---- 运行时产物 ----
logs/
quarantine/
*.log

# ---- AI 配置（含 API 密钥，不入库；模板见 config.ini.example）----
config.ini

# ---- 二进制与安装包（体积大，放在 bina/ 本地保存）----
bina/
*.exe
*.msi
*.zip

# ---- C++ 内核：第三方依赖与构建产物（本地构建，不入库）----
third_party/
cpp/build/

# ---- Nuitka 打包产物 ----
dist/
*.build/
nuitka-crash-report.xml

# ---- 一键构建输出（拷走即用的发布目录）----
releases/

# ---- 特权服务：私钥/密码/生成物（绝不入库，也绝不进发布包）----
service/passwd.txt
service/signing.json
service/generated/
service/bin/

# ---- 编辑器 / IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统 ----
Thumbs.db
Desktop.ini
# ---- 构建产物与本地杂物 ----
*.obj
*.pdb
config.yaml.bak-*
config.ini.bak-*
# 本机笔记，不进仓库
buildingprogress.txt