# AvEngine AI 分析配置模板
# 使用方法: 复制本文件为 config.ini（与本文件同目录），按需修改。
#
#   copy config.ini.example config.ini
#
# 独立于 config.yaml（引擎主配置）。未创建 config.ini 时 AI 功能保持关闭。

[ai]
# 总开关。true 才会启用批次分析/检出联动/后台定时
enabled = false

# OpenAI 兼容端点（必填）。可为:
#   https://api.openai.com/v1
#   https://api.deepseek.com/v1
#   http://127.0.0.1:11434/v1          (本地 Ollama)
# 结尾有无 /v1 均可；程序会自动拼接 /chat/completions
base_url = https://api.openai.com/v1

# API 密钥（本地模型可留空）
api_key = sk-xxxx

# 模型名（必填），例如 gpt-4o-mini / deepseek-chat / qwen2.5:14b
model = gpt-4o-mini

# 单次 HTTP 请求超时（秒）
timeout = 60

# 批次间隔（秒）: 每隔这么久采集一次事件并发给 AI 分析。最小 60
interval = 300

# 单个批次会话的最大轮数（AI 每次回复算一轮；含工具调用往返）
max_rounds = 12

# 单批次最多发送的事件条数
max_events_per_batch = 200

# 单条事件文本的最大字符数
max_event_chars = 600

# 单个工具结果回传给 AI 的最大字符数（超出会截断）
max_tool_result_chars = 12000

# 扫描检出后是否联动 AI 分析（scan 命令发现威胁时）
scan_analysis = true

[sources]
# 各事件源开关。true 的批次源会按 interval 汇总发给 AI。
# 注意: fileio（文件读写）量大，恒不进批次；AI 需要文件访问证据时
#       会用 grep_events 工具按需检索（本开关控制该按需检索是否允许）。
sysmon = true
process = true
network = true
dns = true
powershell = true
system = true
application = true
fileio = true

# ---- 事件通道启用（需要管理员，任选其一）----
# 批次依赖的 ETW 通道若未启用，可用管理员 PowerShell 执行，例如:
#   wevtutil sl "Microsoft-Windows-Sysmon/Operational" /e:true
#   wevtutil sl "Microsoft-Windows-Kernel-File/Operational" /e:true
# 程序启动批次时也会自动尝试启用（失败仅在日志中记录）。
